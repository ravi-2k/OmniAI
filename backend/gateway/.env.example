PORT=8000

# Upstream services (internal URLs)
AUTH_SERVICE=http://localhost:8001
CHAT_SERVICE=http://localhost:8002
AGENT_SERVICE=http://localhost:8003

# Allowed browser origin(s), comma separated. Cookies require an exact origin.
FRONTEND_URL=http://localhost:5173

REDIS_URL=redis://localhost:6379

# Optional: shared secret sent to the services (set the same value everywhere)
INTERNAL_API_KEY=

# Session cookie (must match the auth service)
# COOKIE_SECURE=true          # default: true when NODE_ENV=production
# COOKIE_SAMESITE=strict      # strict | lax | none
# COOKIE_DOMAIN=.example.com  # only to share across app./api. subdomains

# Max wait for an AI response through the gateway (ms)
# AGENT_TIMEOUT_MS=180000
