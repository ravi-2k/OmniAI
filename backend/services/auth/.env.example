PORT=8001

MONGO_URL=
REDIS_URL=redis://localhost:6379

# Firebase Admin credentials. Provide ONE of these (never bake the JSON into an image):
#   FIREBASE_SERVICE_ACCOUNT_BASE64  base64 of the service account JSON (recommended for ECS)
#   FIREBASE_SERVICE_ACCOUNT         the raw JSON string
#   FIREBASE_SERVICE_ACCOUNT_PATH    path to the JSON file (local dev; defaults to ./firebaseServiceAcc.json)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Optional: shared secret expected from the gateway
INTERNAL_API_KEY=

# Session cookie (must match the gateway)
# COOKIE_SECURE=true
# COOKIE_SAMESITE=strict
# COOKIE_DOMAIN=.example.com
