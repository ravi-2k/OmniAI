# Public Firebase web config (not secret) - from the Firebase console
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Leave empty to use the same origin (Vite proxies /api to the gateway in dev)
VITE_API_BASE=

# Dev only: where the Vite proxy sends /api
DEV_GATEWAY_URL=http://localhost:8000
